---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformBadge from '../../components/PlatformBadge.astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import SkillTag from '../../components/SkillTag.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, platform, difficulty, category, tags, tools, room_url } = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC'
}).format(date);
---

<BaseLayout 
  title={`${title} — Writeup`}
  description={description}
  type="article"
  publishedDate={date}
>
  <div class="writeup-container">
    <a href="/writeups" class="back-link">← writeups</a>
    
    <header class="writeup-header">
      <h1 class="title">{title}</h1>
      
      <div class="meta-row">
        <PlatformBadge platform={platform} />
        <span class="divider">·</span>
        <DifficultyBadge difficulty={difficulty} />
        <span class="divider">·</span>
        <span class="date">{formattedDate}</span>
        <span class="divider">·</span>
        <span class="category">{category}</span>
      </div>

      <div class="tags">
        {tags.map((tag: string) => <span class="tag">#{tag}</span>)}
      </div>

      {tools && tools.length > 0 && (
        <div class="tools-row">
          <span class="tools-label">Tools used:</span>
          <div class="tools-list">
            {tools.map((tool: string) => <SkillTag name={tool} />)}
          </div>
        </div>
      )}

      {room_url && (
        <div class="room-link-container">
          <a href={room_url} target="_blank" rel="noopener noreferrer" class="room-link">→ View original challenge</a>
        </div>
      )}
    </header>

    <hr class="header-divider" />

    <article class="markdown-content">
      <Content />
    </article>
  </div>
</BaseLayout>
<script>
  import GLightbox from 'glightbox';
  import 'glightbox/dist/css/glightbox.min.css';

  const setupWriteupLightbox = () => {
    const container = document.querySelector('.markdown-content');
    if (!container || container.dataset.lightboxInitialized === 'true') {
      return;
    }

    const images = container.querySelectorAll('img');
    images.forEach((img) => {
      const existingLink = img.closest('a');
      if (existingLink) {
        existingLink.classList.add('glightbox');
        existingLink.dataset.gallery = 'writeup-gallery';
        if (!existingLink.getAttribute('href')) {
          existingLink.setAttribute('href', img.currentSrc || img.src);
        }
        return;
      }

      const link = document.createElement('a');
      link.href = img.currentSrc || img.src;
      link.className = 'glightbox';
      link.dataset.gallery = 'writeup-gallery';
      if (img.alt) {
        link.dataset.title = img.alt;
      }

      img.parentNode?.insertBefore(link, img);
      link.appendChild(img);
    });

    GLightbox({
      selector: '.markdown-content a.glightbox',
      touchNavigation: true,
      loop: true,
    });

    container.dataset.lightboxInitialized = 'true';
  };

  // Fallback if a table was not wrapped at build time
  const wrapTables = () => {
    const tables = document.querySelectorAll('.markdown-content table');
    tables.forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupWriteupLightbox();
      wrapTables();
    }, { once: true });
  } else {
    setupWriteupLightbox();
    wrapTables();
  }
</script>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .writeup-header {
    margin-bottom: 2rem;
  }

  .title {
    margin-bottom: 1rem;
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  /* ─── FIX 3: meta-row يتعامل صح مع الموبايل ─── */
  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;   /* gap أقل في الارتفاع عشان ما يبقاش في مسافات كبيرة */
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
  }

  /* على الموبايل الـ dividers تتخبى لما الـ items تنزل لسطر تاني */
  @media (max-width: 480px) {
    .divider {
      display: none;
    }
    .meta-row {
      gap: 0.4rem 0.6rem;
    }
  }

  .divider {
    color: var(--text-tertiary);
  }

  .date {
    color: var(--text-secondary);
  }

  .category {
    color: var(--text-secondary);
  }

  .tags {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .tools-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tools-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .tools-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .room-link-container {
    margin-top: 1.5rem;
  }

  .room-link {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .header-divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin-bottom: 3rem;
  }
</style>